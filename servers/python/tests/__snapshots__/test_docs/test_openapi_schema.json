    "/v1/vault/rows": {
      "get": {
        "description": "Rows written after `since`, oldest first. While `more` is true, continue with `cursor` as\n`since` and `mark` as `mark` (protocol 5.3, 7.2, 7.4).",
        "operationId": "pull_v1_vault_rows_get",
        "parameters": [
          {
            "description": "The `cursor` from the last pull; 0 for everything",
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "default": 0,
              "description": "The `cursor` from the last pull; 0 for everything",
              "examples": [
                1040
              ],
              "minimum": 0,
              "title": "Since",
              "type": "integer"
            }
          },
          {
            "description": "The `mark` that came with `since`. If row `since` wasn't written by the push with this mark, the vault's history changed: `409 history_changed`. Leave it out to pull without checking.",
            "in": "query",
            "name": "mark",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^[A-Za-z0-9_-]{1,32}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The `mark` that came with `since`. If row `since` wasn't written by the push with this mark, the vault's history changed: `409 history_changed`. Leave it out to pull without checking.",
              "examples": [
                "Xq3vT0bK9mWc1sPa"
              ],
              "title": "Mark"
            }
          },
          {
            "description": "Most rows to return; at most, and by default, `limits.pull`",
