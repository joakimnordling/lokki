{
  "name": "lokki",
  "version": "0.1.0",
  "private": true,
  "description": "Log values and see them as totals and averages per day, week or month.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "icons": "node scripts/build-icons.js",
    "app-icons": "node scripts/build-app-icons.js",
    "serve": "node scripts/serve.js",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "node scripts/build-site.js && node --test --test-concurrency=1 \"tests/e2e/**/*.test.js\"",
    "build:site": "node scripts/build-site.js",
    "test:sync": "node --test \"tests/sync/**/*.test.js\"",
    "screenshots": "node scripts/screenshots.js"
  },
  "devDependencies": {
    "@fontsource-variable/jost": "^5.3.0",
    "@napi-rs/image": "1.16.0",
    "esbuild": "^0.28.2",
    "hash-wasm": "4.13.0",
    "lucide-static": "1.68.0",
    "playwright": "1.64.1",
    "qr-scanner": "1.4.2"
  }
}
